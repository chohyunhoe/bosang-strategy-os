      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "jsCode": "function authorizeTaskBinding(task, expectedBindings) {\n  const expected = task && expectedBindings && expectedBindings[task.provider];\n  const providers = { claude: 'anthropic', gemini: 'google', gpt: 'openai', reviser: 'anthropic' };\n  if (!expected || typeof expected.credential_ref !== 'string' || typeof expected.account_ref !== 'string' ||\n      /^(SELECT_EXISTING_|UNCONFIGURED_)/.test(expected.credential_ref) ||\n      /^(SELECT_EXISTING_|UNCONFIGURED_)/.test(expected.account_ref) ||\n      providers[task.reviewer] !== task.provider || task.credential_ref !== expected.credential_ref ||\n      task.account_ref !== expected.account_ref || typeof task.model_id !== 'string' ||\n      !/^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$/.test(task.model_id)) {\n    throw Error('INSTALLED_CREDENTIAL_ACCOUNT_BINDING_REQUIRED');\n  }\n}\nconst expectedBindings={\"anthropic\":{\"credential_ref\":\"SELECT_EXISTING_ANTHROPIC_HEADER_AUTH\",\"account_ref\":\"UNCONFIGURED_ACCOUNT\"},\"google\":{\"credential_ref\":\"SELECT_EXISTING_GEMINI_HEADER_AUTH\",\"account_ref\":\"UNCONFIGURED_ACCOUNT\"},\"openai\":{\"credential_ref\":\"SELECT_EXISTING_OPENAI_HEADER_AUTH\",\"account_ref\":\"UNCONFIGURED_ACCOUNT\"},\"runner\":{\"credential_ref\":\"SELECT_EXISTING_LK_RUNNER_HEADER_AUTH\",\"account_ref\":\"UNCONFIGURED_ACCOUNT\"}};\nif($input.all().length!==1)throw Error('ONE_TICKET_PER_CHILD_REQUIRED');\nauthorizeTaskBinding($input.first().json,expectedBindings);return $input.all();"
      }
    },

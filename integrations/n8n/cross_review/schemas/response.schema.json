{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lk-cross-review-response:1.0",
  "title": "Model content is review data, never an execution receipt",
  "type": "object",
  "required": [
    "job_id",
    "snapshot_id",
    "manifest_hash",
    "artifact_version",
    "artifact_hash",
    "schema_version",
    "reviewer",
    "coverage",
    "missing_pages",
    "findings"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "manifest_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifact_version": {
      "type": "integer",
      "minimum": 1
    },
    "artifact_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "schema_version": {
      "const": "lk-cross-review-response/1.0"
    },
    "reviewer": {
      "enum": [
        "claude",
        "gemini",
        "gpt"
      ]
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "doc_id",
          "sha256",
          "pages"
        ],
        "properties": {
          "doc_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "missing_pages": {
      "type": "array",
      "maxItems": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "claim",
          "subject_key",
          "evidence",
          "severity",
          "proposed_decision",
          "reason",
          "original_value",
          "normalized_value",
          "unit",
          "formula",
          "assumptions",
          "counterargument",
          "additional_evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^(?:(?:claude|gemini|gpt):)?[A-Za-z0-9_-]{1,128}$"
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "subject_key": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "doc_id",
                "sha256",
                "pdf_page"
              ],
              "properties": {
                "doc_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          },
          "severity": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "proposed_decision": {
            "enum": [
              "adopt",
              "reject",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "original_value": {},
          "normalized_value": {},
          "unit": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "assumptions": {
            "type": "array"
          },
          "counterargument": {
            "type": "string"
          },
          "additional_evidence": {
            "type": "array"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "proposed_decision": {
                  "enum": [
                    "adopt",
                    "reject"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "decision",
          "reason",
          "counterargument",
          "additional_evidence",
          "action",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^(?:(?:claude|gemini|gpt):)?[A-Za-z0-9_-]{1,128}$"
          },
          "decision": {
            "enum": [
              "adopt",
              "reject",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "counterargument": {
            "type": "string"
          },
          "additional_evidence": {
            "type": "array"
          },
          "action": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "doc_id",
                "sha256",
                "pdf_page"
              ],
              "properties": {
                "doc_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,128}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "pdf_page": {
                  "type": "integer",
                  "minimum": 1
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 4,
                  "maxItems": 4,
                  "items": {
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "decision": {
                  "enum": [
                    "adopt",
                    "reject"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "revision_needed": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reviewer": {
            "const": "gpt"
          }
        }
      },
      "then": {
        "required": [
          "decisions",
          "revision_needed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "reviewer": {
            "const": "claude"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "finding_id": {
                  "pattern": "^claude:[A-Za-z0-9_-]{1,128}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewer": {
            "const": "gemini"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "finding_id": {
                  "pattern": "^gemini:[A-Za-z0-9_-]{1,128}$"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "reviewer": {
            "const": "gpt"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "items": {
              "properties": {
                "finding_id": {
                  "pattern": "^gpt:[A-Za-z0-9_-]{1,128}$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
